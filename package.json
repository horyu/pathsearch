{
  "name": "pathsearch",
  "displayName": "PathSearch",
  "description": "Transform file paths to search queries with customizable patterns and view results in a Peek view",
  "version": "0.3.0",
  "publisher": "horyu",
  "icon": "assets/icon128.png",
  "license": "WTFPL",
  "bugs": {
    "url": "https://github.com/horyu/pathsearch/issues"
  },
  "homepage": "https://github.com/horyu/pathsearch/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/horyu/pathsearch"
  },
  "engines": {
    "vscode": "^1.108.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "search",
    "find",
    "usage",
    "reference",
    "transform",
    "find usages",
    "path alias",
    "monorepo",
    "template",
    "peek references",
    "custom search",
    "regex",
    "ripgrep"
  ],
  "main": "./out/extension.cjs",
  "type": "module",
  "contributes": {
    "commands": [
      {
        "command": "pathsearch.search",
        "title": "PathSearch: Find References",
        "icon": {
          "light": "assets/icon-light.svg",
          "dark": "assets/icon-dark.svg"
        }
      },
      {
        "command": "pathsearch.searchWithPicker",
        "title": "PathSearch: Find References (Always Picker)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PathSearch",
      "properties": {
        "pathsearch.rules": {
          "type": "array",
          "description": "Search rules that define path transforms per file type",
          "items": {
            "type": "object",
            "required": [
              "name",
              "match"
            ],
            "anyOf": [
              {
                "required": [
                  "transforms"
                ]
              },
              {
                "required": [
                  "relative"
                ]
              }
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for this rule"
              },
              "match": {
                "type": "string",
                "description": "Glob pattern to match files (required; empty string matches nothing)"
              },
              "matchWorkspace": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "Workspace name to enable this rule"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Workspace names to enable this rule"
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "values"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "glob",
                          "regex"
                        ]
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "Match workspace names using glob or regex"
                  }
                ],
                "description": "Limit this rule to specific workspace names"
              },
              "maxResults": {
                "type": "number",
                "minimum": 1,
                "maximum": 10000,
                "description": "Maximum number of search results to display in Peek view (overrides pathsearch.maxResults)"
              },
              "transforms": {
                "type": "array",
                "description": "Transform definitions applied to the current file",
                "items": {
                  "type": "object",
                  "required": [
                    "extractFrom",
                    "searchFor"
                  ],
                  "properties": {
                    "extractFrom": {
                      "type": "string",
                      "description": "Regular expression to match against workspace-relative file path"
                    },
                    "searchFor": {
                      "type": "string",
                      "description": "Replacement pattern (use $1, $2 for capture groups)"
                    },
                    "searchAsRegex": {
                      "type": "boolean",
                      "default": false,
                      "description": "Use the result as a regex pattern in search"
                    },
                    "allowNoMatch": {
                      "type": "boolean",
                      "default": false,
                      "description": "Skip this transform when extractFrom does not match"
                    },
                    "searchScope": {
                      "oneOf": [
                        {
                          "type": "string",
                          "description": "Directory to search in (e.g., 'src/')"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Directories to search in (e.g., ['src/', 'app/'])"
                        }
                      ],
                      "description": "Limit search to specific directories. Omit to search entire workspace."
                    },
                    "filePattern": {
                      "oneOf": [
                        {
                          "type": "string",
                          "description": "Glob pattern to filter target files (e.g., '**/*.twig', '!**/dist/**')"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Glob patterns to filter target files (e.g., ['**/*.twig', '!**/dist/**'])"
                        }
                      ],
                      "description": "Limit search to matching files. Omit to search all files."
                    }
                  }
                }
              },
              "relative": {
                "type": "object",
                "description": "Relative path search settings (optional).",
                "required": [
                  "matchTarget"
                ],
                "properties": {
                  "matchTarget": {
                    "type": "string",
                    "enum": [
                      "parentDir",
                      "fileName",
                      "fileStem"
                    ],
                    "description": "What to match for relative imports."
                  },
                  "maxDepth": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 50,
                    "description": "Maximum depth to walk up for relative candidates."
                  },
                  "searchScope": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "Directory to search in (e.g., 'src/')"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Directories to search in (e.g., ['src/', 'app/'])"
                      }
                    ],
                    "description": "Limit search to specific directories. Omit to search entire workspace."
                  },
                  "filePattern": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "Glob pattern to filter target files (e.g., '**/*.twig', '!**/dist/**')"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Glob patterns to filter target files (e.g., ['**/*.twig', '!**/dist/**'])"
                      }
                    ],
                    "description": "Limit search to matching files. Omit to search all files."
                  }
                }
              }
            }
          }
        },
        "pathsearch.showPickerOnMultiple": {
          "type": "boolean",
          "default": false,
          "description": "Show the picker when multiple rules match the current file"
        },
        "pathsearch.maxResults": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum number of search results to display in Peek view"
        },
        "pathsearch.ripgrepPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to ripgrep executable. Leave empty to use ripgrep from PATH."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "pathsearch.search",
          "when": "resourceScheme == file",
          "group": "navigation@50"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pathsearch.search",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build:base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.cjs --external:vscode --format=cjs --platform=node",
    "vscode:prepublish": "pnpm run typecheck && pnpm run lint && node scripts/build.mjs",
    "compile": "pnpm run build:base --sourcemap",
    "watch": "pnpm run build:base --sourcemap --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint src/**/*.ts scripts/*.mjs",
    "lint:fix": "eslint src/**/*.ts scripts/*.mjs --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\"",
    "check": "run-p lint format:check typecheck test",
    "test": "node --test --test-isolation=none --experimental-strip-types \"src/**/*.test.ts\"",
    "test:bridge": "node scripts/test-bridge.mjs",
    "test:bridge:codex": "node scripts/codex-test-bridge.mjs"
  },
  "dependencies": {
    "minimatch": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rnx-kit/third-party-notices": "^2.0.2",
    "@types/node": "^25.1.0",
    "@types/vscode": "^1.108.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
